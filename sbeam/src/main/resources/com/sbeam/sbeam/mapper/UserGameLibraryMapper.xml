<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sbeam.sbeam.mapper.UserGameLibraryMapper">

    <resultMap id="GameLibraryVOMap" type="com.sbeam.sbeam.entity.VO.GameLibraryVO">
        <result column="game_id" property="gameId"/>
        <result column="game_name" property="gameName"/>
        <result column="main_image_url" property="mainImageUrl"/>
        <result column="source" property="source"/>
    </resultMap>

    <select id="selectUserLibrary" resultMap="GameLibraryVOMap">
        select g.game_id,g.game_name,g.main_image_url,ugl.source
        from user_game_library ugl
        join game g on ugl.game_id = g.game_id
        where ugl.user_id = #{userId}
        and ugl.status =0
        and g.status = 0
    </select>

</mapper>
