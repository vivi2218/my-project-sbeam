<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sbeam.sbeam.mapper.MyorderMapper">

    <resultMap id="OrderResultMapper" type="com.sbeam.sbeam.entity.Myorder">
        <id column="order_id" property="orderId"/>
        <result column="user_id" property="userId"/>
        <result column="cart_id" property="cartId"/>
        <result column="order_number" property="orderNumber"/>
        <result column="original_price" property="originalPrice"/>
        <result column="final_price" property="finalPrice"/>
        <result column="order_date" property="orderDate"/>
        <result column="order_status" property="orderStatus"/>
        <result column="status" property="status"/>
        <result column="version" property="version"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
<!--    查询30天前的订单-->
    <select id="selectOldOrders" resultMap="OrderResultMapper">
        SELECT * FROM myorder
        WHERE order_date &lt; DATE_SUB(NOW(), INTERVAL 30 DAY);
    </select>
<!--    批量插入历史表-->
    <insert id="insertOrderHistory" >
        insert into order_history(
                                  order_id,user_id,cart_id,order_number,original_price,final_price,
                                  order_date,order_status,status,version,created_at,updated_at,add_time
        ) values
              <foreach collection="list" item="order" separator=",">
                  (
                   #{order.orderId},#{order.userId},#{order.cartId},#{order.orderNumber},#{order.originalPrice},
                   #{order.finalPrice},#{order.orderDate},#{order.orderStatus},#{order.status},#{order.version},
                  #{order.createdAt},#{order.updatedAt},now()
                  )
              </foreach>
    </insert>
<!--    删除原表-->
    <delete id="deleteOlders">
        delete from myorder
        where order_id in
        <foreach collection="list" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>
</mapper>
